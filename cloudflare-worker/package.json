{
  "name": "grok2api-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run sync-assets && npm run typecheck",
    "dev": "npm run sync-assets && wrangler dev",
    "deploy": "npm run sync-assets && wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy",
    "deploy:upload": "npm run sync-assets && wrangler versions upload",
    "deploy:upload:local": "npm run build && wrangler versions upload",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx",
    "sync-assets": "node ./scripts/sync-assets.mjs"
  },
  "dependencies": {
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@cloudflare/workers-types": "^4.20260124.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.61.0"
  }
}
